{
  "name": "nantianmen-cli",
  "version": "0.3.15",
  "description": "Nantianmen CLI - node-only command line tool",
  "type": "module",
  "bin": { "nantianmen": "./index.js" },
  "scripts": {
    "cli:build": "cd cli && bun build ./index.js --compile --target=bun-windows-x64 --outfile=../releases/nantianmen-cli-0.3.15-win-x64.exe && cp -r ../server ../releases/server"
  }
}
